# GEMINI_API_KEY / AI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# GEMINI_API_KEY=MY_GEMINI_API_KEY
AI_API_KEY=your_secure_free_api_key_here

RELEASE_STORE_FILE=comedyhub-release-key.jks
RELEASE_STORE_PASSWORD=your_store_password_here
RELEASE_KEY_ALIAS=comedyhub_alias
RELEASE_KEY_PASSWORD=your_key_password_here
